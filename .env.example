# Copy this file to .env and fill in real values. Never commit .env.
# Every setting lives in .env and ONLY there: nothing is read from the shell environment and no value
# is hardcoded in code. A missing key stops start-up with an error listing it.

# --- LLM: Azure OpenAI (leave AZURE_OPENAI_API_KEY empty to run offline on rules) ---
LLM_MAX_COMPLETION_TOKENS=16384
LLM_REQUEST_TIMEOUT_SECONDS=90
LLM_REASONING_EFFORT=low
LLM_CLIENT_MAX_RETRIES=1

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_FAST_DEPLOYMENT=

# --- Agent ---
NYAYAVEDIKA_OFFLINE=0
NYAYAVEDIKA_REDACT=1
NYAYAVEDIKA_AGENT_MAX_STEPS=8
NYAYAVEDIKA_AGENT_FAST=1
NYAYAVEDIKA_AGENT_HISTORY_MESSAGES=8
NYAYAVEDIKA_AGENT_MESSAGE_CHARS=1500
NYAYAVEDIKA_AGENT_OBSERVATION_CHARS=1500
NYAYAVEDIKA_AGENT_JOB_POLL_SECONDS=0.5

# --- Database (docker compose: use host `db`; add it to DATABASE_LOCAL_HOSTS) ---
DATABASE_URL=sqlite:///nyayavedika_dev.db
DATABASE_SSL_CA=
DATABASE_LOCAL_HOSTS=localhost,127.0.0.1,db
SQLITE_TIMEOUT_SECONDS=30
DB_STATEMENT_TIMEOUT_MS=120000
NYAYAVEDIKA_CHECKPOINTER=memory
CHECKPOINT_DB_URI=
NYAYAVEDIKA_CHECKPOINT_POOL_SIZE=10
CHECKPOINT_POOL_TIMEOUT_SECONDS=20
CHECKPOINT_CONNECT_TIMEOUT_SECONDS=10
POSTGRES_USER=nyayavedika
POSTGRES_DB=nyayavedika
POSTGRES_PASSWORD=change-me

# --- Vector DB: Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX=your-index-name
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBED_MODEL=multilingual-e5-large
PINECONE_UPSERT_BATCH=90
PINECONE_MAX_CHUNK_CHARS=8000
PINECONE_NS_LAW=law
PINECONE_NS_JUDGMENTS=judgments
PINECONE_NS_CASEFILES=casefiles
PINECONE_LEGALAID_NAMESPACE=legal_aid_kb
PINECONE_LEGALAID_INDEX=legal_aid_index
LEGAL_INFO_HTML=legal_info.html

# --- Web search: Tavily ---
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
WEBSEARCH_MAX_RESULTS=5
WEBSEARCH_CONTENT_CHARS=1200
NYAYAVEDIKA_TRUSTED_DOMAINS=nalsa.gov.in,indiacode.nic.in,ecourts.gov.in,njdg.ecourts.gov.in,sci.gov.in,main.sci.gov.in,doj.gov.in,legislative.gov.in,egazette.gov.in,ncrb.gov.in,lawmin.gov.in,services.ecourts.gov.in

# --- OCR: Tesseract ---
NYAYAVEDIKA_TESSERACT_LANG=eng+hin
NYAYAVEDIKA_OCR_DPI=300
OCR_LOW_CONFIDENCE=60
OCR_MIN_ALNUM_CHARS_PER_PAGE=40
OCR_MIN_CHARS_PER_PAGE_AREA=0.0006
OCR_MIN_WORD_CONFIDENCE=20

# --- Legal aid ---
NYAYAVEDIKA_LEGAL_AID_INCOME_LIMIT=300000
NYAYAVEDIKA_MINUTES_PER_PAGE=2.0
LEGAL_AID_HELPLINE=15100
LEGAL_AID_MAX_FOLLOWUPS=5
LEGAL_AID_MAX_QUESTION_DOCUMENTS=2
LEGAL_AID_FOLLOWUP_SESSION_TTL_SECONDS=3600
LEGAL_AID_MAX_TRACKED_SESSIONS=10000

# --- Triage and scheduling weights ---
NEAR_THRESHOLD_PERCENT=75
CUSTODY_POINTS=15
RELEASE_ELIGIBLE_POINTS=20
NEARING_THRESHOLD_POINTS=8
TRIAGE_POINTS={"age_per_year": 3, "age_cap": 25, "decade_years": 10, "vulnerable_each": 6, "chronic_adjournment": 6, "chronic_adjournment_at": 10, "near_disposal": 8, "dormant": 5, "dormant_after_days": 180, "legal_aid": 3}
BAND_CUTS=[["Critical", 60], ["High", 45], ["Medium", 30], ["Routine", 0]]
SLA_DAYS={"Critical": 1, "High": 5, "Medium": 15, "Routine": 30}
DAY_START=10:30
LUNCH=13:30-14:30
ADJOURNED_MINUTES=3
CONFLICT_BUFFER_MINUTES=10
AGING_PER_DEFERRAL=3
AGING_PER_WEEK_LATE=2
AGING_CAP=25
MUST_LIST_RESERVE=0.15
MUST_LIST_AFTER_DEFERRALS=3
ADJOURNMENT_SMOOTHING_K=10
REGISTRY_MAX_REVIEW=40
WEB_FACT_TTL_DAYS=90

# --- Demo build ---
DEMO_MODE=true
DEMO_STATE=Telangana
DEMO_COURT_ID=DEMO-DC
DEMO_SEED_CASES=120
DEMO_MAX_FILES=5
DEMO_MAX_FILE_MB=50
MAX_FILES_PER_FOLDER=2
ALLOWED_EXTS=pdf,png,jpg,jpeg,tiff,tif,txt
DEMO_MAX_PAGES=50
DEMO_MAX_PAGES_HARD_CAP=50
STORAGE_DIR=storage

# --- Worker and LLM budgets ---
WORKER_CONCURRENCY=2
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=30
WORKER_STALE_MINUTES=10
WORKER_POLL_SECONDS=0.5
WORKER_HEARTBEAT_SECONDS=30
MAP_PARALLEL=3
REDUCE_GROUP=8
LLM_CALLS_PER_MINUTE=30
LLM_MAX_RETRIES=4
LLM_TPM_LIMIT=0
DOC_COMPLETION_TOKENS=4000
LLM_MAX_WAIT_SECONDS=12
LLM_RETRY_BASE_SECONDS=2
EXTRACT_MIN_CONFIDENCE=0.5
MAP_PART_TOKENS=9000
SINGLE_PASS_TOKENS=12000
DOC_ANALYST_MAX_ATTEMPTS=2
CHUNK_MAX_LINES=50
CHUNK_OVERLAP_LINES=5
DOCX_FONT=Arial

# --- Access tokens (Authorization: Bearer <token>; use long random strings; empty = role disabled) ---
DEMO_TOKEN_STAFF=change-me-long-random-string
DEMO_TOKEN_LAWYER=change-me-long-random-string
DEMO_TOKEN_CITIZEN=change-me-long-random-string

ANONYMOUS_CITIZEN=true

# --- Server ---
NYAYAVEDIKA_INLINE_WORKER=1
NYAYAVEDIKA_HOST=0.0.0.0
NYAYAVEDIKA_PORT=8000
DEV_API_HOST=127.0.0.1
DEV_API_PORT=8010
SHUTDOWN_JOIN_SECONDS=5
